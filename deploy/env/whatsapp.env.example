NODE_ENV=production
HOST=127.0.0.1
PORT=3100
CONNECTOR_INSTANCE_ID=wasender-connector-1

WHATSAPP_HMAC_SECRET=
LARAVEL_CALLBACK_URL=https://wasender.example.com/internal/whatsapp/events
LARAVEL_INTERNAL_BASE_URL=https://wasender.example.com

WHATSAPP_AUTH_ROOT=/var/lib/wasender/whatsapp/auth
CALLBACK_OUTBOX_ROOT=/var/lib/wasender/whatsapp/callback-outbox
MESSAGE_REQUEST_STORE_PATH=/var/lib/wasender/whatsapp/message-requests.json
CAMPAIGN_TRANSPORT_STORE_PATH=/var/lib/wasender/whatsapp/campaign-transport.json

PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
CALLBACK_TIMEOUT_MS=10000
MAX_RECONNECT_ATTEMPTS=5
SESSION_LEASE_TTL_SECONDS=180
MESSAGE_REQUEST_TTL_HOURS=168

SESSION_WORKERS_ENABLED=true
SESSION_WORKER_REQUEST_TIMEOUT_MS=90000
SESSION_WORKER_MAX_RESTARTS=5
SESSION_WORKER_RESTART_WINDOW_SECONDS=600
SESSION_WORKER_RESTART_BASE_DELAY_MS=2000
SESSION_WORKER_MAX_ACTIVE=50
WHATSAPP_AUTH_DISK_CRITICAL_PERCENT=95

CAMPAIGN_TRANSPORT_ENABLED=true
CAMPAIGN_TRANSPORT_MAX_REQUEST_BYTES=65536
CAMPAIGN_TRANSPORT_IDEMPOTENCY_TTL_HOURS=168
CAMPAIGN_TRANSPORT_MAX_MEDIA_MB=25
CAMPAIGN_TRANSPORT_MEDIA_TIMEOUT_SECONDS=30
CAMPAIGN_TRANSPORT_SEND_TIMEOUT_SECONDS=60
CAMPAIGN_TRANSPORT_SESSION_CONCURRENCY=1
CAMPAIGN_CALLBACK_MAX_ATTEMPTS=10
CAMPAIGN_CALLBACK_BASE_DELAY_SECONDS=10
CAMPAIGN_CALLBACK_MAX_DELAY_SECONDS=900
CAMPAIGN_CORRELATION_RETENTION_DAYS=30
