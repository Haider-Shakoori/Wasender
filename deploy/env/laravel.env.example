APP_NAME=Wasender
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://wasender.example.com

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wasender
DB_USERNAME=wasender
DB_PASSWORD=

CACHE_STORE=redis
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=database-uuids
SESSION_DRIVER=database
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Wasender
OPERATIONS_ALERT_EMAIL=

WHATSAPP_CONNECTOR_URL=http://127.0.0.1:3100
WHATSAPP_HMAC_SECRET=
WHATSAPP_CALLBACK_KEY=
WHATSAPP_SEND_DELAY_MIN_MS=5000
WHATSAPP_SEND_DELAY_MAX_MS=7000

SUBSCRIPTION_DEFAULT_PLAN_SLUG=trial
SUBSCRIPTION_DEFAULT_TRIAL_DAYS=14
