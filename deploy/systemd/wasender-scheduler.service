[Unit]
Description=Wasender Laravel scheduler tick
After=network-online.target redis-server.service mysql.service

[Service]
Type=oneshot
User=wasender
Group=www-data
WorkingDirectory=/var/www/wasender/current
EnvironmentFile=/etc/wasender/laravel.env
ExecStart=/usr/bin/php artisan schedule:run
NoNewPrivileges=true
PrivateTmp=true
UMask=0027
