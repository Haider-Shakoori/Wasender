[Unit]
Description=Wasender WhatsApp connector
After=network-online.target redis-server.service mysql.service
Wants=network-online.target

[Service]
Type=simple
User=wasender
Group=www-data
WorkingDirectory=/var/www/wasender/current/whatsapp-service
EnvironmentFile=/etc/wasender/whatsapp.env
Environment=NODE_ENV=production
Environment=HOME=/var/lib/wasender
ExecStart=/usr/bin/node dist/server.js
Restart=on-failure
RestartSec=5s
StartLimitIntervalSec=300
StartLimitBurst=10
TimeoutStopSec=45
KillSignal=SIGTERM
KillMode=mixed
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
ReadWritePaths=/var/lib/wasender/whatsapp /tmp

[Install]
WantedBy=multi-user.target
