[Unit]
Description=Wasender Laravel queue worker - background
After=network-online.target redis-server.service mysql.service
Wants=network-online.target

[Service]
Type=simple
User=wasender
Group=www-data
WorkingDirectory=/var/www/wasender/current
EnvironmentFile=/etc/wasender/laravel.env
ExecStart=/usr/bin/php artisan queue:work redis --queue=automation-control,automation-steps,automation-delays,integration-webhooks,contact-imports --sleep=2 --tries=3 --timeout=240 --max-time=3600
Restart=always
RestartSec=5s
TimeoutStopSec=180
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
UMask=0027

[Install]
WantedBy=multi-user.target
