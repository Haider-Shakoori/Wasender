[Unit]
Description=Wasender Laravel queue worker - WhatsApp realtime
After=network-online.target redis-server.service mysql.service
Wants=network-online.target

[Service]
Type=simple
User=wasender
Group=www-data
WorkingDirectory=/var/www/wasender/current
EnvironmentFile=/etc/wasender/laravel.env
ExecStart=/usr/bin/php artisan queue:work redis --queue=whatsapp-sessions,whatsapp-messages,inbox,chatbot,default --sleep=1 --tries=3 --timeout=180 --max-time=3600
Restart=always
RestartSec=5s
TimeoutStopSec=120
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
UMask=0027

[Install]
WantedBy=multi-user.target
