[Unit]
Description=Wasender Laravel queue worker - campaigns
After=network-online.target redis-server.service mysql.service
Wants=network-online.target

[Service]
Type=simple
User=wasender
Group=www-data
WorkingDirectory=/var/www/wasender/current
EnvironmentFile=/etc/wasender/laravel.env
ExecStart=/usr/bin/php artisan queue:work redis --queue=campaign-control,campaign-preparation,campaign-dispatch,campaign-retry,campaign-reconciliation --sleep=1 --tries=3 --timeout=240 --max-time=3600
Restart=always
RestartSec=5s
TimeoutStopSec=180
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
UMask=0027

[Install]
WantedBy=multi-user.target
